# Supabase Configuration
# Create a free project at https://supabase.com
# Copy Project URL and Anon Public Key from Project Settings > API:
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_REAL_ANON_PUBLIC_KEY"

# Development Mock Auth (Default: false. Set to "true" only for isolated offline dev testing without Supabase)
VITE_ENABLE_MOCK_AUTH="false"

# Gemini AI (Optional)
VITE_GEMINI_API_KEY=""

# Application Host URL
VITE_APP_URL="http://localhost:3000"
